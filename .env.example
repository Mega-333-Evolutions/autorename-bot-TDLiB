# ---- required ---------------------------------------------------------------
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef
BOT_TOKEN=123456789:replace-with-your-bot-token
OWNER_ID=123456789

# ---- strongly recommended -----------------------------------------------------
# Hugging Face has no persistent disk. Point this at a free Postgres (Neon, Supabase, ...)
# so settings, thumbnails, admins and TDLib's saved login survive restarts.
# Without it the bot uses a local SQLite file that is wiped on every restart.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---- optional -------------------------------------------------------------------
# Extra allowed users (comma separated). The owner can also use /addadmin and /deladmin.
ADMIN_IDS=
# Numeric chat id of a channel/group where the bot posts start-up, job and error notices.
# The bot must be an admin there, and something must have happened in that chat since the bot was added (post any message).
LOG_CHANNEL=

# Files processed at the same time (1-4).
MAX_CONCURRENT_JOBS=1
# Largest file accepted, in MB (Telegram's upload limit for bots is 2000).
MAX_FILE_MB=2000
# Seconds between progress-message edits (minimum 2).
PROGRESS_INTERVAL=4

# Upload a manually renamed episode to a Database Channel and have the channel post bot publish it (README: "Uploading to the
# Database Channel"). Both are needed; leave them empty to switch it off. Numeric ids, like -1001234567890.
DB_CHANNEL=
COMMUNICATION_CHAT=
# The channel post bot's Telegram id: its answers in the communication chat are the only ones read.
CHANNEL_POST_BOT_ID=8950016484

# ---- TDLib ------------------------------------------------------------------------
# The data center the bot's account is on (1-5), if you know it. Otherwise the bot learns it from the first file it sends.
BOT_DC=
# Where TDLib keeps its files and its small database. The login in it is saved in DATABASE_URL and put back at the next start.
# TDLIB_DIR=/tmp/tdlib
# How much TDLib writes to the log: 0 only fatal errors, 1 errors (default), 2 warnings, 3 and up are very noisy.
TDLIB_LOG_LEVEL=1
# EXPERIMENTAL, off by default: upload a big file while it is still downloading (README: "Streaming renames"). 1 = on.
STREAM_RENAME=0

# Set by the Dockerfile; only change for local runs.
# PORT=7860
# TEMP_DIR=/tmp/rename
